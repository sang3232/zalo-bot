# ===================================================
# CẤU HÌNH ZALO BOT
# (Các cài đặt khác — từ khóa, VIP, AI, khung giờ — chỉnh trong giao diện: http://127.0.0.1:3939)
# ===================================================

# Chế độ chạy trình duyệt: true (ẩn giao diện) | false (hiện giao diện)
# Khuyên dùng: false khi quét QR lần đầu, sau đó đổi thành true
HEADLESS=false

# Cổng của giao diện quản lý
UI_PORT=3939

# (Không bắt buộc) API key OpenRouter. Nên nhập trong giao diện → Cài đặt thay vì để ở đây.
OPENROUTER_API_KEY=

# Trình duyệt: để trống = Chromium của Playwright (npx playwright install chromium); msedge = dùng Edge có sẵn
BROWSER_CHANNEL=msedge

# Thư mục chứa shimeji.exe của Yuyuko — bot nhắc lịch qua hộp thư yuyuko_hop_thu.jsonl ở đây.
# Chưa có key OpenRouter trong giao diện thì bot dùng openrouter_key trong config.json của Yuyuko.
YUYUKO_DIR=

# Máy chủ OCR Trạm 1 của Yuyuko (đọc chữ trong ảnh / PDF quét)
OCR_SERVER_URL=http://127.0.0.1:5000/ocr

# (Không bắt buộc) Python dùng để trích chữ pdf/docx/xlsx/pptx — cần pypdf, python-docx, openpyxl
# PYTHON=python
